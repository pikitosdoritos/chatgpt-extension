{
    "manifest_version": 3,
    "name": "My First Extension",
    "version": "1.0.0",
    "description": "Минимальный пример Chrome Extension",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "My Extension"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}